    <VerticalStackLayout VerticalOptions="Start" Padding="0,0,0,20">

        <AbsoluteLayout WidthRequest="735" HeightRequest="480" HorizontalOptions="Center" VerticalOptions="Start">
        <!-- NOTE:
                LayoutBounds="X, Y, Width, Height"
                X = distance from the left
                Y = distance from the top -->

        <!-- Background map -->
        <Image Source="mappa.png"
               Aspect="Fill"
               AbsoluteLayout.LayoutBounds="0, 0, 735, 480" />
               
        <!-- Label that shows the name of a clicked territory -->
        <Label x:Name="tooltipLabel"
               Text=""
               BackgroundColor="Black"
               TextColor="White"
               Padding="15"
               IsVisible="False"
               AbsoluteLayout.LayoutBounds="340, 10, 120, 55"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               FontSize="12"
