           <!-- User information panel starts here -->
         <Frame
               CornerRadius="12"
               HasShadow="True"
               BackgroundColor="White"
               MaximumWidthRequest="760"
               Margin="10"> <!-- Simulates Material Card depth -->

            <HorizontalStackLayout HorizontalOptions="Center">

                <VerticalStackLayout>

                <HorizontalStackLayout HorizontalOptions="Center">
                    <!-- Tank color and army summary -->
                    <Image
                        x:Name="UserTankIcon"
                        Source="red_tank.png"
                        WidthRequest="50"/>
                    <Label 
                        x:Name="NumTanks"
                        VerticalOptions="Center"
                        Margin="10"
                        Text="63"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#333"
                        HorizontalOptions="Center"/>
                    <!-- Owned territory count summary -->
                    <Image
                        Source="flag.png"
                        WidthRequest="40"
                        Margin="50,0,0,0"/>
                    <Label 
                        x:Name="NumTerritories"
                        VerticalOptions="Center"
                        Margin="10"
                        Text=""
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#333"
                        HorizontalOptions="Center"/>

                    <!-- Round number -->
                    <Image
                        x:Name="RoundCounterIcon"
                        Source="round.png"
                        Margin="50,0,0,0"
                        WidthRequest="45"/>
                    <Label 
                        x:Name="RoundCounter"
                        VerticalOptions="Center"
                        Margin="10"
                        Text="1"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#333"
                        HorizontalOptions="Center"/>


                    <!-- Remaining reinforcement tank counter -->
                    <VerticalStackLayout x:Name="tankReinforcementView"
                        Margin="50,-14,0,0"
                        IsVisible ="False">
                        <HorizontalStackLayout HorizontalOptions="Center">
                        <!-- Remaining tank icon -->
                            <Image x:Name="tankReinforcementIcon"
                                Source="green_tank.png"
                                Margin="0,0,0,-10"
                                WidthRequest="55"/>
                            <Image Source="add.png"
                                Margin ="-17,0,0,29"
                                WidthRequest="20"/>
                        </HorizontalStackLayout>
                        <!-- Two labels for the remaining reinforcement tanks -->
                        <Label 
                            HorizontalTextAlignment="Center"
                            MaximumWidthRequest="136"
                            FontSize="11"
                            Text="Numero di carri armati ancora da posizionare: "/>
                        <Label x:Name="counterTankReinforcement"
                            HorizontalOptions="Center"
                            FontAttributes="Bold"
                            Text="10"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

                <!-- Goal summary -->
                <HorizontalStackLayout Margin="0,5,0,15" HorizontalOptions="Center">
                    <Label 
                        HorizontalTextAlignment="Center"
                        Text="OBIETTIVO:"
                        TextColor="#333"
                        FontSize="15" />
                    <Label 
                        HorizontalTextAlignment="Center"
                        x:Name="GoalDescr"
                        Text="...."
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#333"
                        Margin="10,0,0,0"/>
                </HorizontalStackLayout>

                 <!-- Buttons -->
                <HorizontalStackLayout  HorizontalOptions="Center">

                    <Button
                        Margin="0,0,10,0"
                        ImageSource="cannon.png"
                        HeightRequest="40"
                        BackgroundColor="#FFC3450A"
                        Text="ATTACCA"
                        x:Name="AttackButton"
                        Clicked="OnAttackButtonClicked"
                        IsVisible="False"
                        />

                    <Button 
                        Margin="0,0,10,0"
                        x:Name="PassButton"
                        Text="PASSA TURNO"
                        BackgroundColor="#B25804A1"
                        ImageSource="pass.png"
                        HeightRequest="40"                        
                        IsVisible="False"
                        Clicked="OnPassButtonClicked"/>
                    

                    <!-- Statistics button -->
                    <Button
                        IsVisible="False"
                        x:Name="statisticsButton"
                        Margin="0,0,10,0"
                        ImageSource="statistics.png"
                        HeightRequest="40"
                        Text="STATISTICHE"
                        Clicked="OnViewStatisticsClicked"
                        BackgroundColor="#FF8B4A2D"
                        />

                    <!-- End game button -->
                    <Button
                        Margin="0,0,10,0"
                        x:Name="endGameButton"
                        IsVisible="True"
                        ImageSource="endgame.png"
                        HeightRequest="40"
                        Text="TERMINA PARTITA"
                        BackgroundColor="#FF4FABF1"
                        Clicked="OnEndGameClicked"
                        />
                    
                    

                </HorizontalStackLayout>
            </VerticalStackLayout>
                        
        </HorizontalStackLayout>
