<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniWar.ShowDiceResultPage">

        <!-- Material Card -->
        <Frame Padding="25"
               CornerRadius="12"
               HasShadow="True"
               BackgroundColor="White"
               Margin="10"
               MaximumWidthRequest="770"
               VerticalOptions="Center">
            
            <VerticalStackLayout>

              <!-- Dice icons and text -->
              <HorizontalStackLayout
                HorizontalOptions="Center">
                <Image
                Source="dice.png"
                WidthRequest="90"
                />
                <Label
                    VerticalOptions="Center"
                    Text="Risultato dell'attacco"
                    FontSize="22"
                    />
              </HorizontalStackLayout>


              
              <!-- User dice -->
              <Label Text="I tuoi dadi"
                     FontSize="15"
                     TextColor="#666"
                     HorizontalOptions="Center"
                     Margin="0,5,0,10"/>

                <HorizontalStackLayout x:Name="userDiceImages"
                    HorizontalOptions="Center">
                    <Image
                      IsVisible ="False"
                    Source="attack5.png"
                    WidthRequest="100"
                    Margin="10"
                    />
                    <Image
                      IsVisible ="False"
                    Source="attack6.png"
                    WidthRequest="100"
                    Margin="10"
                    />
                    <Image
                      IsVisible ="False"
                    Source="attack2.png"
                    WidthRequest="100"
                    Margin="10"
                    />
              </HorizontalStackLayout>


              <!-- CPU dice -->
              <Label Text="Dadi avversario"
                     FontSize="15"
                     TextColor="#666"
                     HorizontalOptions="Center"
                     Margin="0,5,0,10"/>

                <HorizontalStackLayout x:Name="cpuDiceImages"
                    HorizontalOptions="Center">
                    <Image
                    IsVisible ="False"
                    Source="defend5.png"
                    WidthRequest="100"
                    Margin="10"
                    />
                    <Image
                      IsVisible ="False"
                    Source="defend6.png"
                    WidthRequest="100"
                    Margin="10"
                    />
                    <Image
                      IsVisible ="False"
                    Source="defend.png"
                    WidthRequest="100"
                    Margin="10"
                    />
              </HorizontalStackLayout>


              
              <!-- Warning text (for example, exceptions) -->
              <Label  
                x:Name="WarningText"
                IsVisible="True"
                TextColor="Black"
                Padding="10"
                HorizontalOptions="Center"
                Margin="0,10,0,25"/>

              <Button
                Text="Ok, mostrami la mappa"
                WidthRequest="200"
                Clicked="OnConfirmButtonClicked"
                Margin="0,0,0,0"
                BackgroundColor="DarkGreen"
                
                />
                     
            </VerticalStackLayout>
            
        </Frame>

</ContentPage>
